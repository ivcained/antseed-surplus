# Copy to .env and chmod 600 .env. Never commit populated .env/wallet files.
# Surplus INFERENCE key only (inf_), never an inf_admin_ management key.
SURPLUS_API_KEY=inf_REPLACE_ME
# Alternative: remove SURPLUS_API_KEY and point at an owner-only plain/dotenv file.
# SURPLUS_API_KEY_FILE=/absolute/path/to/private-surplus-key

# Existing owner-only JSON wallet: {"address":"0x...","private_key":"0x..."}.
# To create one at this path: npm run setup -- --generate-wallet --accept-estimated-pricing
ANTSEED_WALLET_FILE=.state/seller-wallet.json
# Alternative: remove ANTSEED_WALLET_FILE and set ANTSEED_PRIVATE_KEY=0x...
ANTSEED_BASE_RPC_URL=https://base.gateway.tenderly.co
# Public IP/domain:signaling-port. Forward TCP 6881/6882 on a NAT router.
# Run only after filling this with YOUR reachable address (never copy another seller's IP).
ANTSEED_PUBLIC_ADDRESS=YOUR_PUBLIC_IP:6882

# Default native Groq model; requests still go to Surplus, not directly to Groq.
# Exact service names matter in AntSeed. Review provider/cache policy before adding models.
MODELS=openai-gpt-oss-120b
PRICING_POLICY_FILE=.state/pricing-policy.json
MARGIN_BPS=500
SAFETY_BPS=500
ANTSEED_FEE_BPS=400
STATE_DIR=.state
MAX_CONCURRENT=2
MAX_OUTPUT_TOKENS=4096
MAX_INPUT_BYTES=131072
GATEWAY_PORT=18791
DHT_PORT=6881
SIGNALING_PORT=6882
PRICE_REFRESH_SECONDS=120
QUOTE_MAX_AGE_SECONDS=300

# Treasury is DRY-RUN unless --execute is explicitly supplied to topup/monitor.
# All amounts below are integer micro-USDC: 1 USDC = 1000000 micros.
# setup records a checkpoint; only later confirmed AntSeed revenue is spendable here.
TOPUP_EXECUTE=false
TOPUP_THRESHOLD_MICRO=1000000
TOPUP_TARGET_MICRO=2000000
TOPUP_MAX_MICRO=1000000
TOPUP_DAILY_CAP_MICRO=2000000
TOPUP_WALLET_RESERVE_MICRO=0
TOPUP_ETH_RESERVE_WEI=100000000000000
TOPUP_MAX_FEE_PER_GAS_WEI=100000000
TOPUP_MAX_GAS_COST_WEI=50000000000000
TOPUP_L1_FEE_RESERVE_WEI=10000000000000
TOPUP_CONFIRMATIONS=20
TOPUP_RECEIPT_POLL_ATTEMPTS=30
TOPUP_CREDIT_POLL_ATTEMPTS=30
TOPUP_POLL_MS=2000

# Never enable outside an explicitly bounded test. Loss mode sells at 10% of estimates.
LOSS_TEST=false
# LOSS_TEST_UNTIL=2026-01-01T00:00:00Z
# LOSS_TEST_MAX_REQUESTS=2
